{# templates/admin/stock/occasions.html.twig #}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Occasions — {{ stock.name }}{% endblock %}

{% block main %}
    <div class="mb-3">
        <a href="{{ ea_url().setDashboard('App\\Controller\\Admin\\DashboardController').setController('App\\Controller\\Admin\\EasyAdmin\\StockCrudController').setAction('detail').setEntityId(stock.id) }}" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Retour à la fiche stock
        </a>
    </div>

    {% set maxDisplayed = 200 %}
    {% set totalCount = stock.occasions|length %}
    {% if totalCount > maxDisplayed %}
        <p class="text-muted">Affichage des {{ maxDisplayed }} premières occasions sur {{ totalCount }} au total.</p>
    {% endif %}
    <table class="table align-middle">
        <tr>
            <th>#</th>
            <th>Image</th>
            <th>Boite</th>
            <th>Référence</th>
            <th class="text-center">Prix HT</th>
            <th>En ligne</th>
        </tr>
        {% for value in stock.occasions|slice(0, maxDisplayed) %}
            <tr>
                <td>
                    {% include "components/catalog/_card_admin_link_to_entity.html.twig" with {'occasion': value} %}
                </td>
                <td>
                    <img class="card_catalog_img" style="max-width:120px" src="{{ vich_uploader_asset(value.boite, 'imageFile') }}"/>
                </td>
                <td>
                    {{ value.boite.name }} - {{ value.boite.editor }} - {{ value.boite.year }}
                    <ul>
                        <li>État de la boite : {{ value.boxCondition }}</li>
                        <li>État du matériel : {{ value.equipmentCondition }}</li>
                        <li>Règle du jeu : {{ value.gameRule }}</li>
                    </ul>
                </td>
                <td>{{ value.reference }}</td>
                <td class="text-center">{{ (value.priceWithoutTax) / 100 |number_format(2, '.', ',') }} €</td>
                <td class="text-center">{{ value.isOnline ? '<i class="fa-solid fa-circle text-success"></i>' : '<i class="fa-solid fa-circle text-danger"></i>' }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted">Aucune occasion</td></tr>
        {% endfor %}
    </table>
{% endblock %}
