{# templates/admin/occasion/ventes.html.twig #}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Ventes — {{ occasion.reference }}{% endblock %}

{% block main %}
    <div class="mb-3">
        <a href="{{ ea_url().setDashboard('App\\Controller\\Admin\\DashboardController').setController('App\\Controller\\Admin\\EasyAdmin\\OccasionCrudController').setAction('edit').setEntityId(occasion.id) }}" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Retour à la fiche occasion
        </a>
    </div>

    <table class="table align-middle">
        <tr>
            <th>Document</th>
            <th>Date</th>
            <th class="text-center">Prix HT</th>
        </tr>
        {% for line in occasion.documentLines %}
            <tr>
                <td>
                    {% if line.document.billNumber %}
                        Facture n°{{ line.document.billNumber }}
                    {% else %}
                        Devis n°{{ line.document.quoteNumber }}
                    {% endif %}
                </td>
                <td>{{ line.document.createdAt ? line.document.createdAt|date('d.m.Y') : '' }}</td>
                <td class="text-center">{{ (line.priceExcludingTax / 100)|number_format(2, '.', ',') }} €</td>
            </tr>
        {% else %}
            <tr><td colspan="3" class="text-center text-muted">Aucune vente</td></tr>
        {% endfor %}
    </table>
{% endblock %}
