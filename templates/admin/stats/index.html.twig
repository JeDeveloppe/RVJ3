{# templates/admin/stats/index.html.twig #}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Statistiques{% endblock %}

{% block main %}
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">Articles les plus vendus</div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Référence</th>
                                <th class="text-end">Quantité vendue</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in bestSellingItems %}
                                <tr>
                                    <td>{{ row.name }}</td>
                                    <td>{{ row.reference }}</td>
                                    <td class="text-end">{{ row.totalQuantitySold }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="3" class="text-center text-muted">Aucune donnée</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">Boîtes avec le plus d'articles vendus <span class="text-muted small">(toutes éditions confondues)</span></div>
                <div class="card-body p-0">
                    <div class="accordion accordion-flush" id="accordionBestSellingBoites">
                        {% for group in bestSellingBoitesGrouped %}
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#boiteGroup{{ loop.index }}">
                                        <span class="flex-grow-1">{{ group.name }}</span>
                                        <span class="badge bg-secondary me-2">{{ group.total }}</span>
                                        {% if group.editions|length > 1 %}
                                            <span class="text-muted small me-2">{{ group.editions|length }} éditions</span>
                                        {% endif %}
                                    </button>
                                </h2>
                                <div id="boiteGroup{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#accordionBestSellingBoites">
                                    <div class="accordion-body p-0">
                                        <table class="table table-sm mb-0">
                                            <tbody>
                                                {% for edition in group.editions %}
                                                    <tr>
                                                        <td class="text-muted small">#{{ edition.id }} — {{ edition.editorName }}{% if edition.year > 0 %} — {{ edition.year }}{% endif %}</td>
                                                        <td class="text-end">{{ edition.totalQuantitySold }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-center text-muted p-3 mb-0">Aucune donnée</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">Poids et prix moyen d'une boîte</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-end">Avec les boîtes à 0</th>
                                <th class="text-end">Sans les boîtes à 0</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><b>Poids moyen</b></td>
                                <td class="text-end">{{ (averages.avgWeigthAll)|number_format(0, '.', ' ') }} g <span class="text-muted small">({{ averages.nbBoitesAll }})</span></td>
                                <td class="text-end">{{ (averages.avgWeigthExcl0)|number_format(0, '.', ' ') }} g <span class="text-muted small">({{ averages.nbBoitesWeigthExcl0 }})</span></td>
                            </tr>
                            <tr>
                                <td><b>Prix HT moyen</b></td>
                                <td class="text-end">{{ (averages.avgHtPriceAll / 100)|number_format(2, '.', ' ') }} € <span class="text-muted small">({{ averages.nbBoitesAll }})</span></td>
                                <td class="text-end">{{ (averages.avgHtPriceExcl0 / 100)|number_format(2, '.', ' ') }} € <span class="text-muted small">({{ averages.nbBoitesHtPriceExcl0 }})</span></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="mb-0 mt-2 text-muted small">Le nombre entre parenthèses est le nombre de boîtes utilisées dans le calcul.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
