{# templates/admin/my-custom-page.html.twig #}

{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Accueil ADMINISTRATION{% endblock %}

{% block main %}

    {% if is_granted('ROLE_ADMIN') %}

        {# Barre d'actions rapides #}
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                {% include "admin/components/_options_page.html.twig" %}
            </div>

            {% if app.request.server.get('PAIEMENT_MODULE') == "HELLOASSO" %}
                <div class="d-flex align-items-center gap-2 border rounded px-3 py-2 bg-light">
                    <i class="fa-solid fa-rotate text-warning"></i>
                    <span class="small text-muted">Réconciliation HelloAsso automatique à chaque connexion</span>
                    <a class="btn btn-sm btn-warning" href="{{ path('admin_verification_achats_helloAsso') }}" target="_blank">
                        Forcer une vérification maintenant
                    </a>
                </div>
            {% endif %}
        </div>

        {# Section Totaux #}
        <h3 class="mt-2 mb-3 text-primary"><i class="fa fa-chart-pie me-2"></i>Vue d'ensemble</h3>
        <div class="row g-4 mb-5">
            {% for total in totals %}
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card shadow-sm h-100 border-0 border-top border-4 {{ total.isMoney ? 'border-success' : 'border-primary' }}">
                        <div class="card-body text-center">
                            <i class="fa fa-{{ total.isMoney ? 'euro-sign' : 'list-ol' }} fa-2x {{ total.isMoney ? 'text-success' : 'text-primary' }} mb-3"></i>
                            <h4 class="card-title text-muted text-uppercase small mb-2">{{ total.name }}</h4>
                            <p class="h3 fw-bold mb-0">
                                {% if total.isMoney == true %}
                                    <span class="text-success">{{ (total.total) / 100 |number_format(2, '.', ',') }} €</span>
                                {% else %}
                                    <span class="text-primary">{{ total.total }}</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <hr>

        {# Section Ventes en attente #}
        <div class="d-flex align-items-center gap-2 mt-5 mb-3">
            <h3 class="mb-0"><i class="fa fa-hourglass-half me-2"></i>Ventes en attente de paiement</h3>
            {% if documentsEnAttenteDePaiement is defined %}
                <span class="badge {{ documentsEnAttenteDePaiement > 0 ? 'bg-danger' : 'bg-success' }} rounded-pill">{{ documentsEnAttenteDePaiement }}</span>
            {% endif %}
        </div>

        {% if documentsEnAttenteDePaiement is defined and documentsEnAttenteDePaiement == 0 %}
            <div class="alert alert-success d-flex align-items-center mb-5" role="alert">
                <i class="fa fa-check-circle fa-lg me-2"></i>
                Aucune vente en attente de paiement pour le moment.
            </div>
        {% else %}
            <div class="row g-3 mb-5">
                {% for detail in detailsDesVentesEnAttenteDePaiement %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card p-3 shadow-sm h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <h5 class="card-title mb-0">{{ detail.name }}</h5>
                                <p class="h4 fw-bold mb-0 text-danger">{{ detail.valeur }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <hr>

        {# Section Articles avec un stock à 0 #}
        <div class="d-flex align-items-center gap-2 mt-5 mb-3">
            <h3 class="mb-0"><i class="fa fa-boxes-stacked me-2"></i>Articles en rupture de stock</h3>
            {% if itemsWithStockIsNull is not empty %}
                <span class="badge bg-danger rounded-pill">{{ itemsWithStockIsNull|length }}</span>
            {% endif %}
        </div>
        <div class="row g-2">
            {% for item in itemsWithStockIsNull %}
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card border-danger shadow-sm h-100">
                        <div class="card-body d-flex align-items-center justify-content-between p-3">
                            <span class="fw-bold text-danger">{{ item.name }}</span>
                            {% include "components/catalog/_card_admin_link_to_entity_item.html.twig" with {'item': item} %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                        <i class="fa fa-check-circle fa-lg me-2"></i>
                        Aucun article en rupture de stock pour le moment.
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

{% endblock %}
