{% extends "components/_base.html.twig" %}

{% block title %}Notre Boutique{% endblock %}

{% block body %}

<div class="row g-0 justify-content-center align-items-center py-5">
    <div class="col-11 col-md-8 text-center">
        <h1 class="text-purple">Notre Boutique</h1>
        <p class="mt-4">
            Retrouvez nos jeux complets d'occasion (jeux de socièté et puzzles),<br/> ainsi qu'un large choix de pièces détachées.
        </p>
    </div>
</div>

{% for store in stores %}
    <div class="row g-0 justify-content-center bg-light py-4">
        <div class="col-11 col-md-8 p-4">
            <div class="card h-100 p-3 shadow-sm border-0">
                <div class="row g-0">
                    <div class="col-12 col-lg-6">
                        <div class="p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fa-solid fa-location-dot fa-2x text-purple me-3"></i>
                                <h3 class="h5 m-0">Nous trouver</h3>
                            </div>
                            <p>
                                <b>Adresse :</b><br>
                                {{ store.street }}<br>
                                {{ store.city }}
                            </p>
                        </div>
                        <div class="p-4">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fa-solid fa-location-dot fa-2x text-purple me-3"></i>
                                <h3 class="h5 m-0">Nous contacter</h3>
                            </div>
                            <p>
                                <b>Email : {{ store.email }} </b><br>
                                <b>Télephone : {{ store.phone }} </b><br>
                            </p>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 p-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fa-solid fa-clock fa-2x text-purple me-3"></i>
                            <h3 class="h5 m-0">Horaires</h3>
                        </div>
                        <table class="table table-borderless table-sm">
                            <tbody>
                                {% set now = "now"|date("U") %}
                                {% set currentDay = "now"|date("l", "Europe/Paris") %}
                                {% set frenchDays = {
                                    'Monday': 'Lundi', 'Tuesday': 'Mardi', 'Wednesday': 'Mercredi',
                                    'Thursday': 'Jeudi', 'Friday': 'Vendredi', 'Saturday': 'Samedi',
                                    'Sunday': 'Dimanche'
                                } %}
                                
                                {% set last_day = '' %}
                                {% for hour in store.openingHours %}
                                    {% if hour.dayOfWeek != last_day %}
                                        <tr {% if hour.dayOfWeek == frenchDays[currentDay] %}class="fw-bold text-success bg-light"{% endif %}>
                                            <td><b>{{ hour.dayOfWeek }}:</b></td>
                                            <td>
                                                {% if hour.isClosed %}
                                                    Fermé
                                                {% else %}
                                                    {{ hour.openingTime }} - {{ hour.closingTime }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% set last_day = hour.dayOfWeek %}
                                    {% else %}
                                        <tr {% if hour.dayOfWeek == frenchDays[currentDay] %}class="fw-bold bg-light"{% endif %}>
                                            <td></td>
                                            <td>
                                                {% if not hour.isClosed %}
                                                    et {{ hour.openingTime }} - {{ hour.closingTime }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="col-12 mt-4 p-4">
                        <iframe src="{{ store.googleMapEmbedUrl }}"
                                width="100%"
                                height="300"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                        <div class="text-center mt-3">
                            <a href="{{ store.googleMapUrl }}" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">
                                <i class="fa-solid fa-location-dot me-1"></i> Voir sur Google Maps
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-0 justify-content-center bg-light py-4 pb-5">
        <div class="col-11 col-md-8">
            <h2 class="text-center mb-4">Photos de la boutique</h2>

            {% if store.storePhotos is defined and store.storePhotos|length > 0 %}
                <div class="position-relative store-photos-wrapper">
                    <button type="button" class="btn btn-yellow position-absolute top-50 start-0 translate-middle-y d-none store-photos-prev" style="z-index: 2;" aria-label="Photos precedentes">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="d-flex overflow-auto gap-3 pb-3 store-photos-scroll" style="scroll-snap-type: x mandatory; justify-content: safe center;">
                        {% for photo in store.storePhotos %}
                            <div class="flex-shrink-0" style="width: 220px; scroll-snap-align: start;">
                                <a href="#" class="store-photo-link" data-bs-toggle="modal" data-bs-target="#storePhotoModal" data-full-image-url="{{ asset('uploads/images/stores/' ~ photo.fileName) }}">
                                    <img src="{{ asset('uploads/images/stores/' ~ photo.fileName) }}"
                                        class="img-fluid rounded shadow-sm w-100 h-100"
                                        style="object-fit: cover; aspect-ratio: 1/1;"
                                        alt="Photo de la boutique">
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn btn-yellow position-absolute top-50 end-0 translate-middle-y d-none store-photos-next" style="z-index: 2;" aria-label="Photos suivantes">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            {% else %}
                <p class="text-center">Aucune photo de la boutique n'est disponible pour le moment.</p>
            {% endif %}
        </div>
    </div>

{% endfor %}

{# Modale Bootstrap pour afficher une photo de boutique en grand (meme pattern que templates/admin/quoteRequest/manualQuoteRequestDetails.html.twig) #}
<div class="modal fade" id="storePhotoModal" tabindex="-1" aria-labelledby="storePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="storePhotoModalLabel">Photo de la boutique</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img src="" id="storePhotoModalImage" class="img-fluid" alt="Photo de la boutique agrandie">
            </div>
        </div>
    </div>
</div>

<div class="row g-0 justify-content-center py-5">
    <div class="col-11 col-md-8 text-center">
        <h2>Une question ? Contactez-nous !</h2>
        <a href="{{ path('app_contact') }}" class="btn btn-dark text-uppercase mt-3">Nous contacter</a>
    </div>
</div>

{% endblock %}
{% block javascript %}
    <script>
        window.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.store-photos-wrapper').forEach(function(wrapper) {
                const scroller = wrapper.querySelector('.store-photos-scroll');
                const prevBtn = wrapper.querySelector('.store-photos-prev');
                const nextBtn = wrapper.querySelector('.store-photos-next');

                //?on n'affiche les fleches que si les photos debordent reellement de la largeur visible
                if (scroller.scrollWidth <= scroller.clientWidth) {
                    return;
                }
                prevBtn.classList.remove('d-none');
                nextBtn.classList.remove('d-none');

                prevBtn.addEventListener('click', function() {
                    scroller.scrollBy({ left: -240, behavior: 'smooth' });
                });
                nextBtn.addEventListener('click', function() {
                    scroller.scrollBy({ left: 240, behavior: 'smooth' });
                });
            });

            const storePhotoModalElement = document.getElementById('storePhotoModal');
            const storePhotoModalImage = document.getElementById('storePhotoModalImage');
            if (storePhotoModalElement) {
                storePhotoModalElement.addEventListener('show.bs.modal', function(event) {
                    storePhotoModalImage.src = event.relatedTarget.dataset.fullImageUrl;
                });
            }
        });
    </script>
{% endblock %}