{% extends 'components/_base.html.twig' %}

{% block title %}Offres d'emploi{% endblock %}

{% block body %}

    <div class="row g-0 justify-content-around align-items-center py-4">
        <h1 class="col-12 text-center"><span class="text-purple">Offres</span> d'emploi</h1>
    </div>

    <div class="row g-0 justify-content-center bg-white">
        <div class="col-11 col-md-10 my-4">
            {% if jobPosts is empty %}
                <p class="text-center text-gray-dark opacity-75">Aucune offre d'emploi n'est publiée pour le moment.</p>
            {% endif %}

            {% for jobPost in jobPosts %}
                <a href="{{ path('app_job_post_show', {id: jobPost.id, slug: jobPost.slug}) }}" class="text-decoration-none">
                    <div class="card job-post-card mb-4">
                        <div class="card-body p-4">
                            <span class="job-post-badge mb-3">
                                <i class="fa-solid fa-briefcase"></i>
                                {{ jobPost.contractType }}
                            </span>
                            {% if jobPost.location %}
                                <span class="job-post-badge job-post-badge-location mb-3">
                                    <i class="fa-solid fa-location-dot"></i>
                                    {{ jobPost.location }}
                                </span>
                            {% endif %}
                            <h2 class="job-post-title mt-2 mb-2">{{ jobPost.title }}</h2>
                            <p class="job-post-dates small mb-3">
                                <i class="fa-regular fa-clock"></i>
                                Mise en ligne le {{ jobPost.startPublished | date('d F Y') | format_datetime('long', 'none', locale='fr') }}
                                — Visible jusqu'au {{ jobPost.endPublished | date('d F Y') | format_datetime('long', 'none', locale='fr') }}
                            </p>
                            {% if jobPost.description is not null %}
                                {% set excerpt = jobPost.description | striptags | html_decode | trim %}
                                <p class="card-text text-gray-dark">
                                    {{ excerpt | length > 200 ? excerpt | slice(0, 200) ~ '…' : excerpt }}
                                </p>
                            {% endif %}
                            <span class="btn job-post-apply text-white mt-2">
                                En savoir plus <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    {% include "components/_separateur_wave.html.twig" %}

{% endblock %}
